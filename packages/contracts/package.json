{
  "name": "@playersense/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from the API's own OpenAPI document.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts",
    "./openapi.json": "./openapi.json"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "lint": "echo \"@playersense/contracts has no sources to lint; its TypeScript is generated\" && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}

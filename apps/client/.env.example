# The client dashboard's settings. Copy to .env beside this file and fill in.
#
# Values already in the environment win over this file, which is how a deployment sets them.
# At runtime each can also be set as NUXT_PUBLIC_API_BASE and NUXT_PUBLIC_FIREBASE_<NAME>
# (NUXT_PUBLIC_FIREBASE_API_KEY, ...).

# Where the PlayerSense API answers.
API_PUBLIC_URL=http://localhost:21080

# The Firebase web app's config, from the Firebase console: Project settings > General >
# Your apps > the web app > SDK setup and configuration. Public by design: the Firebase
# web SDK ships these in the browser bundle, and they grant nothing without a signed-in user.
# Sign-in methods are enabled in Authentication > Sign-in method: Email/Password with
# "Email link (passwordless sign-in)", Google, Apple, Microsoft and GitHub.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

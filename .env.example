# PlayerSense — local Stage 1 stack.
# Copy to .env and adjust. Values exported in the real environment win over this file.
#
# Ports are deliberately NOT the service defaults: a 21xxx block, below the macOS
# ephemeral range (49152+) so nothing collides with an OS-assigned port. Change them
# here and nowhere else — compose and the Go config both read these.

# --- PostgreSQL (default 5432) -----------------------------------------------
PG_PORT=21432
PG_USER=playersense
PG_PASSWORD=playersense_local
PG_DATABASE=playersense
POSTGRES_DSN=postgres://playersense:playersense_local@127.0.0.1:21432/playersense?sslmode=disable

# --- ClickHouse (defaults 8123 / 9000) ---------------------------------------
CH_HTTP_PORT=21123
CH_NATIVE_PORT=21900
CH_USER=playersense
CH_PASSWORD=playersense_local
CH_DATABASE=playersense
CLICKHOUSE_DSN=clickhouse://playersense:playersense_local@127.0.0.1:21900/playersense

# --- Valkey (default 6379) ---------------------------------------------------
VALKEY_PORT=21379
VALKEY_DSN=redis://127.0.0.1:21379/0

# --- Pub/Sub emulator (default 8085) — reserved, not used in this slice ------
PUBSUB_EMULATOR_PORT=21085

# --- Compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=playersense

<!--
  The macros that ReplicatedMergeTree's default path is built from.

  The replica path is /clickhouse/tables/{shard}/{database}/{table}, and it is baked into
  every replicated table at CREATE — so these are read from the environment rather than
  written inline, and changing one later orphans every znode already written under it.

  There is one deployment, so both are constants today. They stay macros because the
  alternative is literals inside the table definitions, which is the version that cannot
  be changed at all.
-->
<clickhouse>
    <macros>
        <shard from_env="CH_SHARD"/>
        <replica from_env="CH_REPLICA"/>
    </macros>
</clickhouse>
